{
  "compiler_path": "g++",
  "compiler_std": "c++20",
  "headers_path": [
    "../../include/KDbg",
    "../../include"
  ],
  "sources_path": [ "src/*.cpp" ],
  "output_name": "libAnt.KDbg.so",
  "compiler_flags": [ "-shared", "-fPIC", "$(pkg-config --cflags --libs libxml-2.0)", "-lxml2" ],
  "cpp_macros": [
    "__TIER0KIT__=202505",
    "TIER0KIT_USE_STRUCTS=1",
    "DEBUGGERKIT_POSIX=1",
    "_UNICODE=1",
    "DK_KRNL_DEBUGGER=1"
  ]
}

