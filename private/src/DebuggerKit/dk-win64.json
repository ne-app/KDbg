{
  "compiler_path": "x86_64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": [
    "../../include/DebuggerKit",
    "../../include"
  ],
  "sources_path": [ "src/*.cpp" ],
  "output_name": "AntDebuggerKit.dll",
  "compiler_flags": ["-shared" ],
  "cpp_macros": [
    "__TIER0KIT__=202505",
    "TIER0KIT_USE_STRUCTS=1",
    "DEBUGGERKIT_WINDOWS=1",
    "_UNICODE=1",
    "DK_KRNL_DEBUGGER=1",
    "kDistReleaseBranch=$(git rev-parse --abbrev-ref HEAD)-$(uuidgen)"
  ]
}

