<?xml version="1.0" encoding="UTF-8"?>
<NavigationHints>
	<Pragma Key="ImageType">
		DEBUG
	</Pragma>
	<Pragma Key="SystemURI">antoskrnl.exe</Pragma>
	<Pragma Key="SystemPort">3000</Pragma>
	<Pragma Key="PreprocessorMacro">
		_DEBUG
	</Pragma>
	<Image url="kdbg://antoskrnl.exe"/>
	<Image url="kdbg://rpchost.exe"/>
	<Image url="kdbg://anthost.exe"/>
	<Image url="kdbg://HAL.dll"/>
	<Image url="kdbg://System.dll"/>
	<Image url="kdbg://DDK.dll"/>
	<Image url="kdbg://DDK.DDS.dll"/>
	<Image url="kdbg://antosldr.exe"/>
</NavigationHints>
